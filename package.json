{
  "name": "genkit-gcp-goggles",
  "version": "0.1.0",
  "description": "Terminal dashboard for monitoring Genkit AI apps running on Google Cloud. View metrics, traces, and span I/O right from your terminal.",
  "type": "module",
  "bin": {
    "genkit-gcp-goggles": "dist/bin/cli.js"
  },
  "files": [
    "dist",
    "docs/hero.png"
  ],
  "scripts": {
    "start": "tsx bin/cli.tsx",
    "dev": "tsx watch bin/cli.tsx",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "genkit",
    "gcp",
    "google-cloud",
    "monitoring",
    "tracing",
    "telemetry",
    "dashboard",
    "cli",
    "terminal",
    "ink",
    "ai",
    "llm",
    "observability"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pavelgj/genkit-gcp-goggles.git"
  },
  "homepage": "https://github.com/pavelgj/genkit-gcp-goggles#readme",
  "bugs": {
    "url": "https://github.com/pavelgj/genkit-gcp-goggles/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@pppp606/ink-chart": "^0.2.5",
    "google-auth-library": "^9.14.0",
    "ink": "^7.0.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "meow": "^13.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
